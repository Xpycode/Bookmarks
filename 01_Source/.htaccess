# Default Strato shared hosting is fine without rewrites — index.php handles routing.
DirectoryIndex index.php

# Hide dotfiles
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Don't list directories
Options -Indexes

# PWA manifest needs the right MIME type or browsers reject it.
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

# NOTE: NO PHP-handler directive. Strato has PHP enabled by default on this
# account; adding `SetHandler application/x-httpd-php` here actually BREAKS
# execution because Strato uses PHP-FastCGI (not mod_php), and it then sends
# back the file with Content-Type: application/x-httpd-php as a literal label.
# Confirmed by inspecting LUCESUMBRARUM, apps.lucesumbrarum.com, and
# RemoteInterviewSetupGuide — all working PHP sites, none have a PHP handler
# directive. See CHANGELOG.md "Known issue" entry for the full diagnosis.
