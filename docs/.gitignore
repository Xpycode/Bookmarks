# macOS
.DS_Store

# Embedding cache
.fastembed_cache/

# ── Framework files: kept on disk for Claude reference, NOT tracked here ──
# The LLM-Directions framework (00_*.md, commands/, cookbook/, hooks/, etc.)
# lives upstream at github.com/Xpycode/LLM-Directions and re-clones via /setup
# when needed. Tracking it in this project's repo just bloats history.
#
# Strategy: ignore everything in docs/ root by default, then explicitly
# re-include the project-authored artifacts.

/*

!/.gitignore
!/PROJECT_STATE.md
!/decisions.md
!/sessions
!/research
!/specs
